    {
      "cell_type": "code",
      "source": [
        "def plot_tour(coords, tour, ax, color, label):\n",
        "    n = len(tour)\n",
        "    ax.scatter(coords[:, 0], coords[:, 1], c=\"tab:blue\")\n",
        "    for i, (x, y) in enumerate(coords):\n",
        "        ax.text(x + 0.01, y + 0.01, str(i), fontsize=9)\n",
        "\n",
        "    for k in range(n):\n",
        "        i = tour[k]\n",
        "        j = tour[(k + 1) % n]\n",
        "        x_coords = [coords[i, 0], coords[j, 0]]\n",
        "        y_coords = [coords[i, 1], coords[j, 1]]\n",
        "        ax.arrow(\n",
        "            x_coords[0],\n",
        "            y_coords[0],\n",
        "            x_coords[1] - x_coords[0],\n",
        "            y_coords[1] - y_coords[0],\n",
        "            length_includes_head=True,\n",
        "            head_width=0.015,\n",
        "            color=color,\n",
        "            alpha=0.8,\n",
        "        )\n",
        "    ax.set_aspect(\"equal\", \"box\")\n",
        "    ax.grid(True, alpha=0.3)\n",
        "    ax.set_title(label)\n",
        "\n",
        "fig, axes = plt.subplots(1, 2, figsize=(10, 4))\n",
        "\n",
        "plot_tour(coords, tour_exact, axes[0], color=\"tab:green\",\n",
        "          label=f\"CVXPY tour (cost = {obj_exact:.2f})\")\n",
        "plot_tour(coords, tour_pso, axes[1], color=\"tab:red\",\n",
        "          label=f\"PSO tour (cost = {obj_pso:.2f})\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
      ],
