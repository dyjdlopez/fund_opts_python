          "text": [
            "Exact CVXPY tour: [0, 8, 2, 4, 3, 9, 1, 5, 6, 7]\n",
            "Exact tour cost: 3.2792105192794527\n",
            "PSO tour: [4, 2, 8, 0, 7, 6, 5, 1, 9, 3]\n",
