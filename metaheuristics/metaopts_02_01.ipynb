    {
      "cell_type": "markdown",
      "source": [
        "### 2.3. PSO with CVXPY Models"
      ],
      "metadata": {
        "id": "drUgomc4Ji9a"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def decode_tour_from_keys(keys):\n",
        "    keys = np.array(keys)\n",
        "    order = np.argsort(keys)\n",
        "    return order\n",
        "\n",
        "def tsp_tour_length(tour, coords):\n",
        "    n = len(tour)\n",
        "    length = 0.0\n",
        "    for k in range(n):\n",
        "        i = tour[k]\n",
        "        j = tour[(k + 1) % n]\n",
        "        length += np.linalg.norm(coords[i] - coords[j])\n",
        "    return length\n",
        "\n",
        "def build_tsp_pso_problem(coords):\n",
        "    n = coords.shape[0]\n",
        "    bounds = IntegerVar(lb=[0]*n, ub=[n-1]*n, name=\"keys\")\n",
        "\n",
        "    def obj(solution):\n",
        "        tour = decode_tour_from_keys(solution)\n",
        "        return tsp_tour_length(tour, coords)\n",
        "\n",
        "    problem = {\n",
        "        \"obj_func\": obj,\n",
        "        \"bounds\": bounds,\n",
        "        \"minmax\": \"min\",\n",
        "        \"log_to\": \"pso_tsp_log.txt\",\n",
        "    }\n",
        "    return problem"
      ],
      "metadata": {
        "id": "ttt8u8ihVUsK"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def solve_tsp_with_pso(coords, epoch=200, pop_size=40, seed=0):\n",
        "    np.random.seed(seed)\n",
        "    problem = build_tsp_pso_problem(coords)\n",
        "\n",
        "    model = PSO.OriginalPSO(\n",
        "        epoch=epoch,\n",
        "        pop_size=pop_size,\n",
        "        c1=2.0,\n",
        "        c2=2.0,\n",
        "        w_min=0.3,\n",
        "        w_max=0.8,\n",
        "    )\n",
        "\n",
        "    g_best = model.solve(problem)\n",
        "    best_tour = decode_tour_from_keys(g_best.solution)\n",
        "    best_length = tsp_tour_length(best_tour, coords)\n",
        "\n",
        "    return best_tour, best_length, g_best"
      ],
      "metadata": {
        "id": "z3aCE2A2VaQp"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Instantiate a random TSP instance and solve exactly with CVXPY\n",
        "n = 10\n",
        "tour_exact, obj_exact, coords = solve_random_tsp(n, seed=0)\n",
        "\n",
        "\n",
        "\n",
        "# Solve the same instance with PSO\n",
        "tour_pso, obj_pso, g_best = solve_tsp_with_pso(coords, epoch=100, pop_size=1000, seed=0)\n",
        "\n",
        "\n",
        "print(\"Exact CVXPY tour:\", tour_exact)\n",
        "print(\"Exact tour cost:\", obj_exact)\n",
        "print(\"PSO tour:\", tour_pso.tolist())\n",
        "print(\"PSO tour cost:\", obj_pso)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "FyzFcEJrViE9",
        "outputId": "aaa83540-01eb-4c9a-cc91-2a8f8ef1c91b"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
