    {
      "cell_type": "code",
      "source": [
        "C = np.zeros((n, n))\n",
        "for i in range(n):\n",
        "    for j in range(n):\n",
        "        if i != j:\n",
        "            C[i, j] = np.linalg.norm(coords[i] - coords[j])\n",
        "\n",
        "# Decision variables\n",
        "x = cp.Variable((n, n), boolean=True)\n",
        "u = cp.Variable(n)\n",
        "\n",
        "constraints = []\n",
        "\n",
        "# No self-loops\n",
        "for i in range(n):\n",
        "    constraints.append(x[i, i] == 0)\n",
        "\n",
        "# Degree constraints: exactly one outgoing and one incoming arc per city\n",
        "for i in range(n):\n",
        "    constraints.append(cp.sum(x[i, :]) == 1)  # outgoing\n",
        "    constraints.append(cp.sum(x[:, i]) == 1)  # incoming\n",
        "\n",
        "# MTZ subtour-elimination constraints\n",
        "constraints.append(u[0] == 0)\n",
        "for i in range(1, n):\n",
        "    constraints.append(u[i] >= 1)\n",
        "    constraints.append(u[i] <= n - 1)\n",
        "\n",
        "for i in range(1, n):\n",
        "    for j in range(1, n):\n",
        "        if i != j:\n",
        "            constraints.append(u[i] - u[j] + n * x[i, j] <= n - 1)\n",
        "\n",
        "# Objective\n",
        "objective = cp.Minimize(cp.sum(cp.multiply(C, x)))\n",
        "prob = cp.Problem(objective, constraints)\n",
        "\n",
        "prob.solve()\n",
        "\n",
        "print(\"Status:\", prob.status)\n",
        "print(\"Optimal tour cost:\", prob.value)\n"
      ],
