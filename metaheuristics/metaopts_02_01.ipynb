      "source": [
        "gap_rows = []\n",
        "for n in sorted(results_df[\"n_cities\"].unique()):\n",
        "    cvx_obj = results_df[(results_df[\"n_cities\"] == n) & (results_df[\"solver\"] == \"CVXPY\")][\"objective\"].iloc[0]\n",
        "    pso_obj = results_df[(results_df[\"n_cities\"] == n) & (results_df[\"solver\"] == \"PSO\")][\"objective\"].iloc[0]\n",
        "    gap_rows.append({\"n_cities\": n, \"obj_gap\": pso_obj - cvx_obj})\n",
        "\n",
        "gap_df = pd.DataFrame(gap_rows)\n",
        "\n",
        "plt.figure(figsize=(5, 4))\n",
        "plt.plot(gap_df[\"n_cities\"], gap_df[\"obj_gap\"], marker=\"o\")\n",
        "plt.axhline(0.0, color=\"k\", linestyle=\"--\", linewidth=1)\n",
        "plt.xlabel(\"Number of cities (n)\")\n",
        "plt.ylabel(\"Objective gap (PSO − CVXPY)\")\n",
        "plt.title(\"Objective value difference vs. number of cities\")\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.show()"
      ],
